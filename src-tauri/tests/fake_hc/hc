#!/usr/bin/env python3
"""Fake hc. Replays S0 fixtures. Never talks to a real core."""
import json
import os
import sys
import time

ARGS = sys.argv[1:]
MODE = os.environ.get("FAKE_HC_MODE", "live")
LOG = os.environ.get("FAKE_HC_LOG")
ROOT = os.path.dirname(os.path.abspath(__file__))
FIX = os.path.join(ROOT, "fixtures")


def log():
    if not LOG:
        return
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(" ".join(ARGS) + "\n")


def load(name):
    with open(os.path.join(FIX, name), encoding="utf-8") as f:
        return f.read()


def emit(text, rc=0):
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    sys.exit(rc)


def stamp_file():
    p = os.environ.get("FAKE_HC_STAMP")
    if p:
        return p
    if LOG:
        return LOG + ".stamp"
    return None


def stamp_n():
    p = stamp_file()
    if not p or not os.path.exists(p):
        return 0
    try:
        return int(open(p, encoding="utf-8").read().strip() or "0")
    except ValueError:
        return 0


def bump_stamp():
    p = stamp_file()
    if not p:
        return
    with open(p, "w", encoding="utf-8") as f:
        f.write(str(stamp_n() + 1))


def died():
    return MODE == "die_after_run" and stamp_n() >= 1


def refuse():
    sys.stderr.write("connection refused\n")
    sys.exit(1)


log()
cmd = ARGS[0] if ARGS else ""

# Core died after `run --bg` returned an id. Later commands refuse.
# A second `run` is still logged above, then refused.
if died() and cmd != "run":
    refuse()

if cmd == "server":
    if "status" not in ARGS:
        sys.stderr.write("server start is not a read\n")
        sys.exit(9)
    if MODE == "down":
        sys.stderr.write(
            '{"error":{"kind":"unavailable","message":"core down","hint":""}}\n'
        )
        sys.exit(1)
    emit(load("server_status.json"))

if cmd == "events":
    if MODE in ("crash", "down"):
        sys.exit(0)
    sys.stdout.write("{}\n")
    sys.stdout.flush()
    time.sleep(30)
    sys.exit(0)

if cmd == "get":
    if MODE == "not_found":
        sys.stderr.write(load("not_found.json"))
        if not load("not_found.json").endswith("\n"):
            sys.stderr.write("\n")
        sys.exit(3)
    if MODE == "socket":
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    if MODE == "blocked":
        emit(load("get_blocked.json"))
    emit(load("get.json"))

if cmd == "ls":
    emit(load("ls.json"))

if cmd == "read":
    if MODE in ("socket", "down"):
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    if MODE == "read_fail":
        sys.stderr.write("not-json\n")
        sys.exit(1)
    if MODE == "blocked":
        # History above the screen stalls on a permission prompt (S0).
        # The screen (--lines 0) returns immediately.
        n = "40"
        if "--lines" in ARGS:
            i = ARGS.index("--lines")
            if i + 1 < len(ARGS):
                n = ARGS[i + 1]
        if n != "0":
            time.sleep(30)
        emit(load("read_blocked.json"))
    if MODE == "huge":
        line = "A" * 1024
        text = "\n".join([line] * 5000)
        json.dump({"complete": True, "how": "history", "text": text}, sys.stdout)
        sys.stdout.write("\n")
        sys.exit(0)
    if MODE == "secrets":
        text = load("secrets.txt")
        json.dump({"complete": True, "how": "history", "text": text}, sys.stdout)
        sys.stdout.write("\n")
        sys.exit(0)
    if MODE == "ansi":
        text = load("ansi.txt")
        json.dump({"complete": True, "how": "history", "text": text}, sys.stdout)
        sys.stdout.write("\n")
        sys.exit(0)
    emit(load("read.json"))

if cmd == "run":
    if died():
        refuse()
    if MODE == "die_after_run":
        bump_stamp()
    if MODE in ("socket", "down", "crash"):
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    emit(load("run_bg.json"))

if cmd == "send":
    if MODE in ("socket", "down", "crash"):
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    emit(load("send.json"))

if cmd == "wait":
    if MODE in ("socket", "down", "crash"):
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    emit(load("wait.json"))

if cmd == "kill":
    if MODE in ("socket", "down", "crash"):
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    emit(load("kill.json"))

if cmd == "rm":
    if MODE == "rm_live":
        sys.stderr.write(load("rm_live.json"))
        if not load("rm_live.json").endswith("\n"):
            sys.stderr.write("\n")
        sys.exit(1)
    if MODE in ("socket", "down", "crash"):
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    emit(load("rm.json"))

if cmd == "label":
    if MODE in ("socket", "down", "crash"):
        sys.stderr.write("connection refused\n")
        sys.exit(1)
    emit(load("label.json"))

sys.stderr.write("unhandled " + " ".join(ARGS) + "\n")
sys.exit(9)
