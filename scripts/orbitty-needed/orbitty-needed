def ctl(*args: str, json_out: bool = True) -> Any:
    cmd = [CTL]
    if json_out:
        cmd.append("--json")
    cmd.extend(args)
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        err = (p.stderr or p.stdout or "").strip() or f"exit {p.returncode}"
        raise SystemExit(f"orbittyctl failed: {err}")
    if not json_out:
        return p.stdout
    text = (p.stdout or "").strip()
    if not text:
        return None
    try:
        return json.loads(text)
    except json.JSONDecodeError as e:
        raise SystemExit(f"orbittyctl --json not JSON: {e}\n{text[:400]}") from e


def cards_from_state(st: dict) -> list[dict]:
    return list(st.get("kanbanCards") or st.get("kanban_cards") or [])


def is_needed(c: dict) -> bool:
    return (c.get("kind") or "") == "needed"


def nstate(c: dict) -> str:
    return (c.get("neededState") or c.get("needed_state") or "") or ""


def nanswer(c: dict) -> str:
    return (c.get("neededAnswer") or c.get("needed_answer") or "") or ""


def nwhy(c: dict) -> str:
    return (c.get("neededWhy") or c.get("needed_why") or "") or ""


def is_openish(c: dict) -> bool:
    s = nstate(c)
    if s == "open":
        return True
    if s == "later":
        due = c.get("dueAt") or c.get("due_at")
        if due is None:
            return True
        try:
            return int(due) <= int(time.time())
        except (TypeError, ValueError):
            return True
    return False


def card_rec(c: dict) -> dict:
    return {
        "id": c.get("id"),
        "title": c.get("title"),
        "neededState": nstate(c),
        "neededWhy": nwhy(c) or None,
        "neededAnswer": nanswer(c) or None,
        "projectId": c.get("projectId") or c.get("project_id") or "",
        "actor": c.get("actor"),
    }


def dump_card(c: dict) -> None:
    json.dump(card_rec(c), sys.stdout, indent=2)
    sys.stdout.write("\n")


def find_card(cid: str) -> dict:
    st = ctl("state", "get")
    if not isinstance(st, dict):
        raise SystemExit("state.get did not return an object")
    for c in cards_from_state(st):
        if c.get("id") == cid:
            return c
    raise SystemExit(f"no card {cid}")


def find_open_needed_by_title(title: str) -> dict | None:
    """First open Needed with this exact title, if any."""
    title = (title or "").strip()
    if not title:
        return None
    try:
        st = ctl("state", "get")
    except SystemExit:
        return None
    if not isinstance(st, dict):
        return None
    for c in cards_from_state(st):
        if (
            is_needed(c)
            and is_openish(c)
            and (c.get("title") or "").strip() == title
        ):
            return c
    return None


def rules_gate_open(title: str, project: str | None, why: str = "") -> None:
    """Classify + log hit/miss/collide and print RULE_HIT <id> on stderr
    when a rule would apply. OPEN stage: the APP now applies on a can-run
    hit (card born answered, actor=rule) — this gate stays the python-side
    trail and never hides a card itself."""
    card = rules_mod.classify_title(title, project=project or "", why=why or "")
    try:
        store = rules_mod.load_store()
    except rules_mod.RuleError as e:
        rules_mod.log_event({"event": "miss", "title": card["title"],
                             "reason": f"store-unreadable: {e}"})
        return
    hits = rules_mod.match_rules(store, card)
    if rules_mod.is_collision(hits):
        rules_mod.log_event({"event": "collide", "title": card["title"],
                             "rules": [h.get("id") for h in hits]})
    elif hits:
        for h in hits:
            rules_mod.log_event({"event": "hit", "rule": h.get("id"),
                                 "title": card["title"], "applied": False,
                                 "reason": "store-stage: log only, hide waits OPEN"})
        print(f"RULE_HIT {hits[0].get('id')}", file=sys.stderr)
    else:
        rules_mod.log_event({"event": "miss", "title": card["title"]})


def cmd_open(args: argparse.Namespace) -> None:
    existing = find_open_needed_by_title(args.title)
    if existing:
        cid = existing.get("id") or "?"
        title = existing.get("title") or args.title
        print(f"needed {cid} — {title} [already open]", file=sys.stderr)
        dump_card(existing)
        return
    rules_gate_open(args.title, args.project, args.why or "")
    argv = ["needed", "open", "--title", args.title]
    if args.why:
        argv.extend(["--why", args.why])
    if args.project:
        argv.extend(["--project", args.project])
    data = ctl(*argv)
    if isinstance(data, dict):
        cid = data.get("id") or "?"
        title = data.get("title") or args.title
        if nstate(data) == "answered" and (data.get("actor") or "") == "rule":
            # OPEN stage: a standing rule answered at mint — the watch will
            # dispatch it. Not a fresh ping; say so instead.
            print(
                f"needed {cid} — {title} [answered by rule: {nanswer(data)}]",
                file=sys.stderr,
            )
        else:
            print(f"needed {cid} — {title}", file=sys.stderr)
        dump_card(data)
    else:
        print(json.dumps(data, indent=2))


def cmd_list(args: argparse.Namespace) -> None:
    st = ctl("state", "get")
    if not isinstance(st, dict):
        raise SystemExit("state.get did not return an object")
    rows = [c for c in cards_from_state(st) if is_needed(c)]
    if not args.all:
        rows = [c for c in rows if is_openish(c)]
    json.dump([card_rec(c) for c in rows], sys.stdout, indent=2)
    sys.stdout.write("\n")


def cmd_get(args: argparse.Namespace) -> None:
    dump_card(find_card(args.id))


def cmd_wait(args: argparse.Namespace) -> None:
    deadline = time.time() + args.timeout
    while True:
        c = find_card(args.id)
        s = nstate(c)
        if s in ("answered", "skipped"):
            dump_card(c)
            return
        if time.time() >= deadline:
            dump_card(c)
            raise SystemExit(f"timeout waiting for {args.id} (state={s or '?'})")
        time.sleep(max(0.5, args.poll))


def ensure_bus() -> None:
    INBOX.mkdir(parents=True, exist_ok=True)
    ACKED.mkdir(parents=True, exist_ok=True)
    OUTBOX.mkdir(parents=True, exist_ok=True)
    LOGS.mkdir(parents=True, exist_ok=True)
    RUNNING.mkdir(parents=True, exist_ok=True)


def running_pid_path(cid: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", cid)
    return RUNNING / f"{safe}.pid"


def clerk_alive(cid: str) -> bool:
    p = running_pid_path(cid)
    if not p.is_file():
        return False
    try:
        pid = int(p.read_text().strip().split()[0])
    except (OSError, ValueError):
        p.unlink(missing_ok=True)
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        p.unlink(missing_ok=True)
        return False


def mark_clerk_running(cid: str, pid: int) -> None:
    ensure_bus()
    running_pid_path(cid).write_text(f"{pid}\n")


def clear_clerk_running(cid: str) -> None:
    running_pid_path(cid).unlink(missing_ok=True)


def cursor_print_alive() -> bool:
    try:
        r = subprocess.run(
            ["pgrep", "-f", "cursor-agent.*--print"],
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and bool((r.stdout or "").strip())


def other_clerks_alive(except_cid: str | None = None) -> bool:
    ensure_bus()
    skip = (
        re.sub(r"[^A-Za-z0-9_.-]", "_", except_cid) if except_cid else None
    )
    for p in RUNNING.glob("*.pid"):
        if skip and p.stem == skip:
            continue
        try:
            pid = int(p.read_text().strip().split()[0])
        except (OSError, ValueError):
            continue
        try:
            os.kill(pid, 0)
            return True
        except OSError:
            p.unlink(missing_ok=True)
    return False


ORBITTY_PLANET = "p-mtw6850i-f4wnlg"


def companion_hack(on: bool, who: str | None = None, project: str | None = None) -> None:
    """Dock LED + planet chip. A clerk must not wipe a live Cursor writer."""
    if on and cursor_print_alive():
        who = "cursor"
        project = project or ORBITTY_PLANET
    argv = [CTL, "companion", "hack", "--", "on" if on else "off"]
    if on:
        if who:
            argv.extend(["--who", who])
        if project:
            argv.extend(["--project", project])
    try:
        subprocess.run(argv, capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        pass


def dock_hack_off_if_idle(except_cid: str | None = None) -> None:
    if other_clerks_alive(except_cid) or cursor_print_alive():
        return
    companion_hack(False)


