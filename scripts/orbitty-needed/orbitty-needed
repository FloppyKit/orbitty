    src.unlink()
    print(f"acked {args.id}")


def cmd_notify(args: argparse.Namespace) -> None:
    """Session wakeup: print ACTION_REQUIRED for new inbox files. Does not drain events."""
    ensure_bus()
    seen: set[str] = set()
    while True:
        for p in sorted(INBOX.glob("n-*.json")):
            cid = p.stem
            if cid in seen:
                continue
            seen.add(cid)
            try:
                rec = json.loads(p.read_text())
            except (OSError, json.JSONDecodeError):
                rec = {"id": cid}
            title = rec.get("title") or ""
            answer = rec.get("neededAnswer") or rec.get("neededState") or ""
            print(f"ACTION_REQUIRED: needed {cid} {title} :: {answer}", flush=True)
        if args.once:
            return
        time.sleep(max(0.5, args.poll))


def cmd_watch(args: argparse.Namespace) -> None:
    ensure_bus()
    cur = load_cursor()
    while True:
        flush_outbox()
        got = drain_events(
            cur,
            spark=not args.no_ack_spark,
            dispatch=not args.no_dispatch,
        )
        retry_stale(dispatch=not args.no_dispatch)
        for rec in got:
            cid = rec.get("id")
            title = rec.get("title") or ""
            answer = rec.get("neededAnswer") or rec.get("neededState")
            print(f"ACTION_REQUIRED: needed {cid} {title} :: {answer}", flush=True)
        if args.once:
            return
        time.sleep(max(0.5, args.poll))


