def leftover_prompt_for(go: str) -> Path | None:
    """Newest leftover prompt for this GO.

    Packets (`launch-${GO}-leftover*.json`) and `_GO_*_LEFTOVER*_PROMPT.md`
    compete by mtime. A stale packet must not hide a newer leftover file —
    that is a new issue (issued lock).
    """
    cands: list[Path] = []
    for pkt in BUS.glob(f"launch-{go}-leftover*.json"):
        try:
            raw = json.loads(pkt.read_text()).get("prompt") or ""
        except (OSError, json.JSONDecodeError):
            raw = ""
        p = Path(raw).expanduser() if raw else Path()
        if p.is_file():
            cands.append(p)
    slug = "_" + go.replace("-", "_") + "_LEFTOVER"
    for d in plans_read_dirs():
        cands.extend(p for p in d.glob(f"{slug}*_PROMPT.md") if p.is_file())
    if not cands:
        return None
    return max(cands, key=lambda p: p.stat().st_mtime)


def resolve_writer_prompt(go: str, prompt: str | None = None) -> Path:
    if prompt:
        p = Path(prompt).expanduser()
        if p.is_file():
            return p
    pkt = BUS / f"launch-{go}.json"
    if pkt.is_file():
        try:
            raw = json.loads(pkt.read_text()).get("prompt") or ""
        except (OSError, json.JSONDecodeError):
            raw = ""
        p = Path(raw).expanduser() if raw else Path()
        if p.is_file():
            return p
    return go_prompt_path(go)


def workspace_from_prompt(path: Path) -> Path:
    if path.is_file():
        for line in path.read_text().splitlines():
            if line.startswith("Workspace:"):
                ws = Path(line.split(":", 1)[1].strip()).expanduser()
                if str(ws):
                    return ws
    return WS_DEFAULT


def commit_subject_from_prompt(path: Path, go: str) -> str:
    if not path.is_file():
        return go
    text = path.read_text()
    in_commit = False
    for line in text.splitlines():
        if line.startswith("## Commit"):
            in_commit = True
            continue
        if in_commit and line.startswith("## "):
            break
        if in_commit:
            m = re.search(r"`(GO-[A-Z0-9][-A-Z0-9]*(?: leftover:[^`]+)?)`", line)
            if m:
                return m.group(1).strip()
    return go


def pid_is_writer(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        out = subprocess.check_output(
            ["ps", "-p", str(pid), "-o", "command="],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return False
    cmd = out.lower()
    # clerk-run: the watched-clerk wrapper owns the grok writer seat for
    # its whole life (first clerk + one continuation), so its pid IS the
    # writer's liveness.
    return "cursor-agent" in cmd or "kimi-k3-max" in cmd or "/grok" in cmd or "clerk-run" in cmd


def git_head(ws: Path) -> str:
    try:
        return subprocess.check_output(
            ["git", "-C", str(ws), "rev-parse", "HEAD"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return ""


def git_find_subject(ws: Path, subject: str) -> str:
    if not subject:
        return ""
    try:
        raw = subprocess.check_output(
            ["git", "-C", str(ws), "log", "-40", "--pretty=%H%x09%s"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return ""
    for line in raw.splitlines():
        if "\t" not in line:
            continue
        h, s = line.split("\t", 1)
        if s.strip() == subject:
            return h.strip()
    return ""


def git_find_go(ws: Path, go: str) -> str:
    """Newest commit whose subject is this GO (first-cut or leftover).

    GO-ORBITTY-TILE must not match GO-ORBITTY-TILE-YAW.
    """
    go = (go or "").strip()
    if not go:
        return ""
    try:
        raw = subprocess.check_output(
            ["git", "-C", str(ws), "log", "-80", "--pretty=%H%x09%s"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return ""
    for line in raw.splitlines():
        if "\t" not in line:
            continue
        h, s = line.split("\t", 1)
        s = s.strip()
        if s == go or s.startswith(go + " leftover") or s.startswith(go + ":"):
            return h.strip()
    return ""


def is_leftover_prompt(prompt: str | None) -> bool:
    name = Path(prompt or "").name.lower()
    return "leftover" in name


def issued_status(go: str, prompt: str | None = None) -> dict:
    """ok | running | shipped. One launch per GO. Leftover prompt is not a new issue.

    Crash with no commit may retry the same GO (pid dead, not shipped).
    """
    go = (go or "").upper()
    prompt_p = resolve_writer_prompt(go, prompt)
    prompt_s = str(prompt_p) if prompt_p.is_file() else (prompt or "")
    rec = load_issued().get(go) or {}
    ws = Path(rec.get("workspace") or workspace_from_prompt(prompt_p))
    pid = int(rec.get("pid") or 0)
    if pid_is_writer(pid):
        return {
            "status": "running",
            "go": go,
            "prompt": rec.get("prompt") or prompt_s,
            "pid": pid,
            "seat": rec.get("seat"),
            "message": (
                f"Already running {rec.get('seat') or 'writer'} on {go}. "
                "One launch per GO. Not launching again."
            ),
        }
    found = git_find_go(ws, go) or git_find_subject(
        ws, rec.get("commitSubject") or commit_subject_from_prompt(prompt_p, go)
    )
    shipped = bool(rec.get("shipped")) or bool(found)
    if shipped:
        commit = rec.get("shippedCommit") or found
        subject = rec.get("commitSubject") or go
        return {
            "status": "shipped",
            "go": go,
            "prompt": rec.get("prompt") or prompt_s,
            "commit": commit,
            "subject": subject,
            "message": (
                f"Already shipped {go}"
                + (f" (`{commit[:7]}`)." if commit else ".")
                + " One launch per GO. Not launching again."
            ),
        }
    return {
        "status": "ok",
        "go": go,
        "prompt": prompt_s,
        "reason": "retry" if rec else "never",
    }


def issued_mark(
    go: str,
    *,
    pid: int,
    seat: str,
    prompt: str | None = None,
    head: str | None = None,
) -> dict:
    go = (go or "").upper()
    prompt_p = resolve_writer_prompt(go, prompt)
    prompt_s = str(prompt_p) if prompt_p.is_file() else (prompt or "")
    ws = workspace_from_prompt(prompt_p)
    rec = {
        "go": go,
        "prompt": prompt_s,
        "seat": seat,
        "pid": int(pid),
        "at": int(time.time()),
        "headAtLaunch": head or git_head(ws),
        "workspace": str(ws),
        "commitSubject": commit_subject_from_prompt(prompt_p, go),
        "shipped": False,
        "shippedCommit": None,
    }
    d = load_issued()
    d[go] = rec
    save_issued(d)
    return rec


def issued_shipped(go: str, *, commit: str | None = None, prompt: str | None = None) -> dict:
    go = (go or "").upper()
    prompt_p = resolve_writer_prompt(go, prompt)
    d = load_issued()
    rec = d.get(go) or {}
    ws = Path(rec.get("workspace") or workspace_from_prompt(prompt_p))
    subject = rec.get("commitSubject") or commit_subject_from_prompt(prompt_p, go)
    h = (commit or "").strip() or git_find_subject(ws, subject) or git_head(ws)
    rec.update(
        {
            "go": go,
            "prompt": rec.get("prompt") or str(prompt_p),
            "workspace": str(ws),
            "commitSubject": subject,
            "shipped": True,
            "shippedCommit": h,
            "shippedAt": int(time.time()),
            "pid": 0,
        }
    )
    d[go] = rec
    save_issued(d)
    return rec


def flush_outbox() -> list[dict]:
    """Mint cards queued while Orbitty was quit. Fail closed if the socket is down."""
    ensure_bus()
    minted: list[dict] = []
    for p in sorted(OUTBOX.glob("*.json")):
        try:
            rec = json.loads(p.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        title = (rec.get("title") or "").strip()
        if not title:
            continue
        argv = ["needed", "open", "--title", title]
        if rec.get("why"):
            argv.extend(["--why", str(rec["why"])])
        if rec.get("project"):
            argv.extend(["--project", str(rec["project"])])
        try:
            data = ctl(*argv)
        except SystemExit:
            return minted
        p.unlink(missing_ok=True)
        minted.append(data if isinstance(data, dict) else rec)
        with DISPATCH_LOG.open("a") as log:
            log.write(f"outbox minted {title}\n")
    return minted


def load_cursor() -> dict:
    if not CURSOR.is_file():
        off = EVENTS.stat().st_size if EVENTS.is_file() else 0
        return {"offset": off, "seen": []}
    try:
        return json.loads(CURSOR.read_text())
    except (OSError, json.JSONDecodeError):
        return {"offset": 0, "seen": []}


def save_cursor(cur: dict) -> None:
    ensure_bus()
    tmp = CURSOR.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(cur, indent=2) + "\n")
    tmp.replace(CURSOR)


def event_type(ev: dict) -> str:
    for t in ev.get("tags") or []:
        if isinstance(t, list) and len(t) >= 2 and t[0] == "e-type":
            return str(t[1])
    return ""


def event_card_id(ev: dict) -> str:
    raw = ev.get("content") or ""
    if isinstance(raw, dict):
        return str(raw.get("cardId") or "")
    try:
        obj = json.loads(raw) if isinstance(raw, str) else {}
    except json.JSONDecodeError:
        return ""
    return str(obj.get("cardId") or "") if isinstance(obj, dict) else ""


def grok_bin() -> str:
    p = HOME / ".grok" / "bin" / "grok"
    if p.is_file():
        return str(p)
    return shutil.which("grok") or str(HOME / ".local" / "bin" / "grok")


# ---------- GO-ORBITTY-MOUTH-FOREVER: watched clerks ----------
# A clerk never dies silent at the turn cap. Every grok spawn goes through
# `clerk-run` (detached wrapper): it streams the clerk to its OWN log under
# bus/logs, and when that log says "Max turns reached" it runs ONE
# continuation — same packet plus a finish note — then stops. Never a chain.

CLERK_MAX_TURNS = "64"  # lock: omit or >=64; never the old 12.

NEST_CONT_NOTE = (
    "\n\n---\n\nCONTINUATION CLERK: the first clerk hit the max-turns cap "
    "mid-job. Do NOT start over. Read what is already on disk, finish the "
    "stamp/papers, then do the packet's act line: companion note what's "
    "next (one Spark line) and `orbitty-needed ack` this id. Then stop."
)
WRITER_CONT_NOTE = (
    "\n\n---\n\nCONTINUATION SEAT: the first grok seat hit the max-turns cap "
    "mid-GO. Do NOT restart. Pick up from the tree as it is, finish the "
    "prompt's Do list, run its commit step, then companion note what's "
    "next (one Spark line). Then stop."
)


def clerk_env() -> dict:
    return {
        **os.environ,
        "PATH": str(HOME / ".local/bin") + ":" + os.environ.get("PATH", ""),
    }


def clerk_argv(seat: str, prompt_path: Path, sid: str) -> list[str]:
    """One argv builder for both seats — the wrapper rebuilds it for the
    continuation, so the flags can never drift between first clerk and
    continuation."""
    if seat == "writer":
        return [
            grok_bin(),
            "--prompt-file",
            str(prompt_path),
            "--cwd",
            str(workspace_from_prompt(prompt_path)),
            "-s",
            sid,
            "--always-approve",
            "--no-subagents",
            "--max-turns",
            CLERK_MAX_TURNS,
        ]
    rules = NEST_RULES.read_text() if NEST_RULES.is_file() else ""
    return [
        grok_bin(),
        "--prompt-file",
        str(prompt_path),
        "--cwd",
        str(BUS),
        "-s",
        sid,
        "--always-approve",
        "--no-subagents",
        "--disable-web-search",
        "--max-turns",
        CLERK_MAX_TURNS,
        "--output-format",
        "plain",
        f"--rules={rules}",
    ]


def clerk_log_path(cid: str, sid: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", cid)
    return LOGS / f"{safe}-{sid}.log"


def spawn_clerk(seat: str, packet: Path, cid: str, sid: str) -> subprocess.Popen:
    """Detach a watched clerk. The wrapper (not grok) is the returned pid —
    it outlives a capped first clerk and owns the one continuation."""
    ensure_bus()
    log = DISPATCH_LOG.open("a")
    proc = subprocess.Popen(
        [
            sys.executable,
            str(SCRIPT),
            "clerk-run",
            "--seat",
            seat,
            "--packet",
            str(packet),
            "--cid",
            cid,
            "--sid",
            sid,
        ],
        cwd=str(BUS),
        stdout=log,
        stderr=log,
        start_new_session=True,
        env=clerk_env(),
    )
    mark_clerk_running(cid, proc.pid)
    companion_hack(True, who="grok")
    return proc


def run_one_clerk(seat: str, prompt_path: Path, sid: str, cid: str) -> None:
    """Run one grok clerk to completion, streaming to its own log so the
    shared dispatch log stays an index."""
    path = clerk_log_path(cid, sid)
    with DISPATCH_LOG.open("a") as log:
        log.write(f"--- clerk {cid} seat={seat} sid={sid} log={path} ---\n")
    with path.open("a") as lf:
        p = subprocess.run(
            clerk_argv(seat, prompt_path, sid),
            cwd=str(BUS),
            stdout=lf,
            stderr=subprocess.STDOUT,
            env=clerk_env(),
        )
    with DISPATCH_LOG.open("a") as log:
        log.write(f"clerk {cid} sid={sid} exit {p.returncode}\n")


def clerk_hit_cap(cid: str, sid: str) -> bool:
    """Tail-check the clerk log for grok's max-turns death."""
    try:
        with clerk_log_path(cid, sid).open("rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 16384))
            tail = f.read().decode("utf-8", "replace")
    except OSError:
        return False
    return "max turns reached" in tail.lower()


def cmd_clerk_run(args: argparse.Namespace) -> None:
    """One clerk to completion; on 'Max turns reached', ONE continuation
    (same packet + finish note). A capped continuation stays dead so a
    human reads the log — never a chain."""
    ensure_bus()
    try:
        packet = Path(args.packet)
        if not packet.is_file():
            with DISPATCH_LOG.open("a") as log:
                log.write(f"clerk {args.cid}: missing packet {packet}\n")
            return
        run_one_clerk(args.seat, packet, args.sid, args.cid)
        if not clerk_hit_cap(args.cid, args.sid):
            return
        cont_sid = str(uuid.uuid4())
        cont = BUS / f"clerk-cont-{re.sub(r'[^A-Za-z0-9_.-]', '_', args.cid)}.md"
        note = WRITER_CONT_NOTE if args.seat == "writer" else NEST_CONT_NOTE
        try:
            cont.write_text(packet.read_text() + note)
        except OSError as e:
            with DISPATCH_LOG.open("a") as log:
                log.write(f"clerk {args.cid}: continuation prompt failed: {e}\n")
            return
        with DISPATCH_LOG.open("a") as log:
            log.write(f"clerk {args.cid} hit max turns — one continuation {cont_sid}\n")
        run_one_clerk(args.seat, cont, cont_sid, args.cid)
    finally:
        clear_clerk_running(args.cid)
        dock_hack_off_if_idle(args.cid)


SPARK_GO_RE = re.compile(
    r"\b(?:GO-ORBITTY-|GO-MH-|GO-LS-TAURI|GO-PLUG-)",
    re.IGNORECASE,
)
WORK_GO_RE = re.compile(
    r"\b(?:GO-CALLE-|GO-FKT-|GO-DESK-|GO-ICE-|GO-NCH-|GO-RGL-)",
    re.IGNORECASE,
)


def route_bus(
    *,
    title: str = "",
    why: str = "",
    answer: str = "",
    go: str = "",
    workspace: str = "",
    project: str = "",
) -> str:
    """Spark = desktop/Orbitty. Work = everything else. Chat/Hold never."""
    blob = " ".join(
        x for x in (title, why, answer, go, workspace, project) if x
    )
    up = blob.upper()
    low = blob.lower()
    if SPARK_GO_RE.search(up):
        return "spark"
    if any(
        s in up
        for s in (
            "/USERS/DUDE/ORBITTY",
            "ORBITTY.APP",
            "SPACE.ORBITTY.MAC",
            "ORBITTYCTL",
        )
    ):
        return "spark"
    if any(
        s in low
        for s in (
            "herding cat",
            "yard-warn",
            "needed-bus",
            "install-stable",
            "mint repo planet",
            "companion.note",
            "orbitty.space",
        )
    ):
        return "spark"
    if WORK_GO_RE.search(up):
        return "work"
    return "work"


def _ack_quote(answer: str, n: int = 72) -> str:
    a = " ".join((answer or "").split())
    if not a:
        return ""
    if len(a) > n:
        a = a[: n - 1] + "…"
    return a


def spark_ack_line(rec: dict) -> str:
    """One short orientation line that still carries what Matt said."""
    title = (rec.get("title") or rec.get("id") or "Needed").strip()
    state = rec.get("neededState") or ""
    answer = (rec.get("neededAnswer") or "").strip()
    go = extract_go(title) or extract_go(answer) or ""
    q = _ack_quote(answer)
    low = answer.lower()
    leftoverish = any(
        w in low
        for w in (
            "leftover",
            "except",
            "didn't",
            "did not",
            "doesn't",
            "does not",
            "does nothing",
            "bounce",
            "clip",
            "cut off",
            "still",
            "nope",
            "not possible",
            "broken",
            "but ",
        )
    )
    if state == "skipped":
        return f"Skipped {title}."
    if title.startswith("Writer for ") and seat_from_answer(answer):
        seat = seat_from_answer(answer)
        if seat == "wait":
            return f"Parked {go or title}."
        return f"{seat} has {go or title}."
    if title.startswith("Dogfood "):
        if leftoverish:
            return f"Leftover on {go or title}: {q}" if q else f"Leftover on {go or title}."
        return f"Dogfood {go or title}: {q}" if q else f"Noted dogfood on {go or title}."
    if q:
        return f"Noted {title}: {q}"
    return f"Noted {title}."


def should_instant_ack(rec: dict) -> bool:
    """Every answer gets one short Spark line immediately. Clerks add the result later."""
    return True


def _ctl_run(args: list[str], log) -> None:
    try:
        r = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=8,
        )
        if r.returncode != 0:
            log.write(f"spark_ack fail {args}: {(r.stderr or r.stdout or '')[:240]}\n")
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired) as e:
        log.write(f"spark_ack failed {args}: {e}\n")


def spark_ack(rec: dict) -> None:
    """Instant mouth. Sequential mode → note --mode → open → think.
    Parallel Popen raced the note onto Chat and looked like silence.
    Do NOT companion_send — that is a 180s LLM turn.
    """
    rec = dict(rec)
    rec["neededAnswer"] = rules_mod.strip_rule_lines(
        str(rec.get("neededAnswer") or rec.get("needed_answer") or "")
    )
    line = spark_ack_line(rec)
    mode = route_bus(
        title=str(rec.get("title") or ""),
        why=str(rec.get("neededWhy") or rec.get("needed_why") or ""),
        answer=str(rec.get("neededAnswer") or rec.get("needed_answer") or ""),
        go=extract_go(str(rec.get("title") or ""))
        or extract_go(str(rec.get("neededAnswer") or ""))
        or "",
        workspace=str(rec.get("workspace") or ""),
        project=str(rec.get("projectId") or rec.get("project_id") or ""),
    )
    log = DISPATCH_LOG.open("a")
    log.write(f"spark_ack mode={mode} {line}\n")
    log.flush()
    agent = "spark" if mode == "spark" else "grok"
    _ctl_run([CTL, "companion", "mode", "--", mode], log)
    _ctl_run([CTL, "companion", "set-agent", "--", agent], log)
    _ctl_run([CTL, "companion", "note", "--mode", mode, "--", line], log)
    _ctl_run([CTL, "companion", "open"], log)
    _ctl_run([CTL, "companion", "play", "--", "think"], log)
    log.close()


def packet_for(rec: dict, etype: str) -> dict:
    """Self-contained. A fresh grok must not need any other session."""
    return {
