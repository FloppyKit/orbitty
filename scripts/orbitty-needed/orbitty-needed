            "do not repeat a watch ack). Then orbitty-needed ack this id. "
            "Mint leftover Writer via orbitty-needed open (it reuses an "
            "already-open card with the same title). Packet is the whole memory."
        ),
    }


def extract_go(text: str) -> str | None:
    if not text:
        return None
    m = GO_RE.search(text.upper().replace("?", " "))
    return m.group(1) if m else None


def ctl_soft(*args: str) -> Any | None:
    """orbittyctl, or None when Orbitty isn't up. Never raises."""
    try:
        return ctl(*args)
    except SystemExit:
        return None


def go_status(*, go: str = "", file: str = "", card: str = "") -> dict | None:
    """Resolver through orbittyctl. None means the check itself failed."""
    argv = ["go", "status"]
    if file:
        argv.extend(["--file", file])
    elif go:
        argv.extend(["--go", go])
        if card:
            argv.extend(["--card", card])
    else:
        return None
    data = ctl_soft(*argv)
    return data if isinstance(data, dict) else None


def plans_dir() -> Path:
    """Same setting the app uses. No second hardcoded plans path."""
    data = ctl_soft("settings", "plans-dir")
    if isinstance(data, dict):
        raw = (data.get("plansDir") or "").strip()
        if raw:
            return Path(raw).expanduser()
    return HOME / "Orbitty GOs"


def plans_read_dirs() -> list[Path]:
    """plansDir first, then ~/.buzz/PLANS (read-only back-compat)."""
    primary = plans_dir()
    out = [primary]
    if PLANS.is_dir() and PLANS != primary:
