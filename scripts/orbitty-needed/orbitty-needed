def cmd_rule_add(args: argparse.Namespace) -> None:
    params: dict[str, str] = {}
    when: dict[str, str] = {}
    try:
        for kv in args.param:
            p, w = rules_mod.parse_kv_tokens(kv)
            params.update(p)
            when.update(w)
        rule = rules_mod.add_rule(
            params, when, args.answer,
            source_needed_id=args.from_needed,
            note=args.note,
        )
    except rules_mod.RuleError as e:
        raise SystemExit(f"rule add failed (no write): {e}")
    json.dump(rule, sys.stdout, indent=2)
    sys.stdout.write("\n")
    print(f"rule {rule['id']} minted", file=sys.stderr)


def cmd_rule_from_answer(args: argparse.Namespace) -> None:
    """Record a rule Matt typed as RULE: line(s) on card ID's answer.
    Remaining lines = standing answer. go copied from the title if omitted."""
    card = find_card(args.id)
    raw = nanswer(card)
    stripped, params, when, found = rules_mod.parse_rule_lines(raw)
    if not found:
        raise SystemExit(f"{args.id}: no RULE: line in neededAnswer — not inventing one")
    if "go" not in params:
        go = rules_mod.extract_go(card.get("title") or "")
        if go:
            params["go"] = go
    try:
        rule = rules_mod.add_rule(params, when, stripped, source_needed_id=args.id)
    except rules_mod.RuleError as e:
        raise SystemExit(f"rule from-answer failed (no write): {e}")
    json.dump(rule, sys.stdout, indent=2)
    sys.stdout.write("\n")
    print(f"rule {rule['id']} recorded from {args.id}", file=sys.stderr)


def cmd_rule_rm(args: argparse.Namespace) -> None:
