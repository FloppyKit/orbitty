def herdr_server_up() -> bool:
    """True when the Herdr socket answers. Lock: ORBITTY_HERDR_WHEN_PRESENT_LOCK_v0.md."""
    try:
        p = subprocess.run(
            ["herdr", "status"],
            capture_output=True,
            text=True,
            timeout=8,
        )
        return "status: running" in (p.stdout or "")
    except Exception:
        return False


def launch_grok_via_herdr() -> str | None:
    """Grok-kind pickup → launch_agent Herdr pane. None = skip, use nest clerk."""
    if not herdr_server_up():
        return None
    try:
        data = ctl("agent", "pickup", "--name", "herdr-probe")
    except SystemExit:
        return None
    if isinstance(data, dict) and data.get("picked") is False:
        return None
    return f"Herdr pane via herdr-probe pickup ({data!r})"[:400]


def launch_writer(seat: str, go: str, prompt: str | None = None) -> str:
    """seat is cursor or grok. Returns a one-line Spark result."""
    if is_leftover_prompt(prompt):
        return (
            f"Leftover for {go} is papers only. One launch per GO. Not launching."
        )
    sealed = sealed_prompt(go, prompt=prompt)
    if sealed.packet is None:
        return sealed.note
    # Every route below gets the packet: full GO + lock + launcher rules.
    prompt = str(sealed.packet)
    st = issued_status(go, prompt)
    if st.get("status") in ("running", "shipped"):
        return st["message"]
    if seat == "cursor":
        argv = [str(CURSOR_GO), go]
        if prompt:
            argv.append(prompt)
        p = subprocess.run(
            argv,
            capture_output=True,
            text=True,
        )
        out = (p.stdout or p.stderr or "").strip()
        if p.returncode != 0:
            return f"Cursor handoff failed for {go}: {out[-400:]}"
        return f"Cursor Ultra has {go}. {out.splitlines()[-1] if out else ''}".strip()
    if seat == "grok":
        prompt_path = Path(prompt)
        if not prompt_path.is_file():
            return f"No prompt for {go}; grok not launched."
        herdr_line = launch_grok_via_herdr()
        if herdr_line:
            issued_mark(go, pid=0, seat="grok", prompt=str(prompt_path))
            with DISPATCH_LOG.open("a") as log:
                log.write(f"writer {go} seat=grok herdr {herdr_line}\n")
            return herdr_line
        sid = str(uuid.uuid4())
        # Watched clerk: a max-turns death earns ONE continuation with the
        # same prompt + finish note — never a silent 40-turn corpse.
        # The packet is the full GO file (header + body), not the card title.
        proc = spawn_clerk("writer", prompt_path, go, sid)
        issued_mark(go, pid=proc.pid, seat="grok", prompt=str(prompt_path))
        return f"Grok Build session {sid} has {go}."
    return f"Unknown seat {seat}; wait."


def seat_from_answer(answer: str) -> str | None:
    a = (answer or "").strip().lower()
    if a.startswith("cursor") or a in ("c", "ultra", "kimi"):
        return "cursor"
    if a.startswith("grok"):
        return "grok"
    if a.startswith("wait") or a in ("later", "not now"):
        return "wait"
    return None


# ---------- GO-ORBITTY-DOING-FIRE: "Who runs this doing GO?" ----------
# A GO-* todo dragged todo → doing mints this ONE fact title (habitat
# side, doing_fire.rs). The standing answer is EXACTLY '<harness> on this
# planet' (cursor · goose · grok · hermes; case-insensitive, extra words
# illegal) — bare 'cursor' is NOT the Writer seat on this title.
# Leftover orbitty-prefix: the seat Matt taught is ORBITTY-ONLY — the
# why's go= must match GO-ORBITTY* and the Needed's planet must be
# orbitty (id or exact name); any other GO prefix or planet pings.
# Act: find the one agent row with that harness pinned to this Needed's
# projectId (zero → mint '{planetName}-{harness}', two+ → collide ping),
# assign the source todo, then launch_writer / cursor-go the go= prompt
# file — never launch_agent([title]). issued running/shipped, a missing
# prompt, or a live cursor-agent --print → ping, no spawn.
DOING_FIRE_TITLE = "Who runs this doing GO?"
DOING_FIRE_ANSWER_RE = re.compile(
    r"^(cursor|goose|grok|hermes)\s+on\s+this\s+planet$", re.IGNORECASE
)
# The taught policy (Matt 2026-09-13): cursor runs this doing GO when the
# GO is GO-ORBITTY* and the planet is orbitty. Both gates below.
DOING_FIRE_GO_PREFIX = "GO-ORBITTY"
DOING_FIRE_PLANET = "orbitty"


def why_value(why: str, key: str) -> str:
    """First 'key=value' token in a doing-fire why line ("" when absent)."""
    for tok in (why or "").split():
        if tok.startswith(key + "="):
            v = tok.split("=", 1)[1].strip()
            if v:
                return v
    return ""


def doing_fire_log(msg: str) -> None:
    with DISPATCH_LOG.open("a") as log:
        log.write(f"{msg}\n")


def record_doing_fire_rule(cid: str, raw_answer: str) -> None:
    """`from-answer`, never invent: record the RULE: line(s) Matt typed on
    this card. Only runs on the handled path — the fall-through clerk does
    its own from-answer, so a rule is never recorded twice."""
    if not cid:
        return
    try:
        stripped, params, when, found = rules_mod.parse_rule_lines(raw_answer)
    except rules_mod.RuleError as e:
        doing_fire_log(f"doing-fire RULE parse failed {cid}: {e}")
        return
    if not found:
        return
    try:
        rule = rules_mod.add_rule(params, when, stripped, source_needed_id=cid)
    except rules_mod.RuleError as e:
        doing_fire_log(f"doing-fire rule add failed {cid}: {e}")
        return
    doing_fire_log(f"doing-fire rule {rule.get('id')} recorded from {cid}")


def dispatch_doing_fire(rec: dict, raw_answer: str) -> bool:
    """True = handled (no nest clerk). False = cannot-run → the clerk pings."""
    answer = (rec.get("neededAnswer") or "").strip()
    m = DOING_FIRE_ANSWER_RE.match(answer)
    if not m:
        return False  # not the standing answer — Matt gets a clerk ping
    harness = m.group(1).lower()
    why = rec.get("neededWhy") or rec.get("needed_why") or ""
    go = why_value(why, "go").upper()
    card_id = why_value(why, "card")
    project_id = rec.get("projectId") or rec.get("project_id") or ""
    cid = rec.get("id") or ""
    if not go or not project_id:
        doing_fire_log(
            f"doing-fire {cid}: missing go=/projectId (why={why!r} project={project_id!r}) — ping"
        )
        return False
    if not go.startswith(DOING_FIRE_GO_PREFIX):
        # The taught seat is GO-ORBITTY* only — any other GO prefix pings.
        doing_fire_log(f"doing-fire {go}: not {DOING_FIRE_GO_PREFIX}* — ping")
        return False
    sealed = sealed_prompt(go, card=card_id)
    if sealed.packet is None:
        doing_fire_log(f"doing-fire {go}: {sealed.note}")
        # Fail soft: no seal check (old app / Orbitty down) leaves the
        # card's notes alone. A real refusal appends, never replaces.
        if sealed.checked:
            append_card_note(card_id, sealed.note, lambda m: doing_fire_log(f"doing-fire {go}: {m}"))
        return True
    prompt = sealed.packet
    if not prompt.is_file():
        doing_fire_log(f"doing-fire {go}: prompt missing ({prompt}) — ping, no spawn")
        return False
    st = issued_status(go, str(prompt))
    if st.get("status") in ("running", "shipped"):
        doing_fire_log(f"doing-fire {go}: issued {st.get('status')} — ping, no spawn")
        return False
    if harness not in ("cursor", "grok"):
        # launch_writer has no goose/hermes door today — honest ping.
        doing_fire_log(f"doing-fire {go}: no launch door for {harness} — ping, no spawn")
        return False
    if harness == "cursor" and cursor_print_alive():
        doing_fire_log(f"doing-fire {go}: a cursor-agent --print is live — ping, no spawn")
        return False
    try:
        state = ctl("state", "get")
    except SystemExit as e:
        doing_fire_log(f"doing-fire {go}: state get failed: {e} — ping")
        return False
    # The taught seat is planet orbitty only (id or exact name — the same
    # law as the rules `project` param). Any other planet pings.
    projects = (state.get("projects") or []) if isinstance(state, dict) else []
    planet_ok = project_id == DOING_FIRE_PLANET or any(
        isinstance(p, dict)
        and p.get("id") == project_id
        and (p.get("name") or "").strip() == DOING_FIRE_PLANET
        for p in projects
    )
    if not planet_ok:
        doing_fire_log(
            f"doing-fire {go}: planet {project_id!r} is not {DOING_FIRE_PLANET} — ping"
        )
        return False
    rows = []
    for a in (state.get("agentShortcuts") or []) if isinstance(state, dict) else []:
        if not isinstance(a, dict):
            continue
        if (a.get("harness") or "").strip().lower() != harness:
            continue
        # The pin is the match — the row's name never is.
        if (a.get("projectId") or a.get("project_id") or "") != project_id:
            continue
        rows.append(a)
    if len(rows) > 1:
        doing_fire_log(
            f"doing-fire {go}: {len(rows)} {harness} agents on {project_id} — collide, ping"
        )
        return False
    agent = rows[0] if rows else None
    if agent is None:
        planet_name = ""
        for p in (state.get("projects") or []) if isinstance(state, dict) else []:
            if isinstance(p, dict) and p.get("id") == project_id:
                planet_name = (p.get("name") or "").strip()
                break
        name = f"{planet_name or project_id}-{harness}"
        argv = ["agent", "add", "--name", name, "--harness", harness,
                "--project", project_id]
        if harness == "cursor":
            argv.extend(["--model", str(default_runner().get("model") or "grok-4.7-high")])
        try:
            data = ctl(*argv)
        except SystemExit as e:
            doing_fire_log(f"doing-fire {go}: agent add {name} failed: {e} — ping")
            return False
        agent = data if isinstance(data, dict) else {}
        doing_fire_log(f"doing-fire {go}: minted {name} ({agent.get('id') or '?'}) on {project_id}")
    agent_id = agent.get("id") or ""
    if card_id and agent_id:
        try:
            ctl("kanban", "assign", "--id", card_id, "--agent", agent_id)
        except SystemExit as e:
            doing_fire_log(
                f"doing-fire {go}: assign {card_id} → {agent_id} failed: {e} (launching anyway)"
            )
    # The act lands — record Matt's RULE: (from-answer only, never invent).
    record_doing_fire_rule(cid, raw_answer)
    line = launch_writer(harness, go, prompt=str(sealed.source or ""))
    doing_fire_log(f"doing-fire {go} seat={harness} agent={agent.get('name') or agent_id} {line}")
    return True


# WRITER_DONE lock: green / yes / stamp / good (NEST also: confirmed /
# already shipped). Whole answer after RULE-strip — leftover bounce text
# still goes to the clerk (it has to write a leftover prompt).
# Whole-answer only. "green but X is broken" stays leftover.
# "stamped green" / "all green" are Matt's actual stamp phrases
# (2026-09-14: "stamped green" missed this and spawned a 64-turn clerk).
# 2026-09-14 night: "stamp it green dude" also missed — leftover clerk
# launched a writer that rewrote drag and ran install-stable.
DOGFOOD_GREEN_RE = re.compile(
    r"^(?:"
    r"green|yes|stamp|good|confirmed|already\s+shipped|"
    r"stamped\s+green|all\s+green|green\s+stamped|"
    r"it\s+works|"
    r"stamp(?:ed)?(?:\s+it)?\s+green(?:\s+dude)?|"
    r"green\s+dude"
    r")(?:\s*[.!])*$",
    re.I,
)
# Whole-answer wait still parks via the clerk ("later. Same card."). Any
# other non-green answer is a leftover bounce for the template clerk.
DOGFOOD_WAIT_RE = re.compile(r"^(?:wait|later|not\s+now)(?:\s*[.!])*$", re.I)


def stamp_dogfood_green(go: str, cid: str) -> Path:
    """Mechanical stamp. Do not overwrite a stamp a clerk already wrote."""
    slug = (go or "UNKNOWN").replace("-", "_")
    for d in plans_read_dirs():
        existing = d / f"STAMP_{slug}.md"
        if existing.is_file():
            return existing
    path = plans_dir() / f"STAMP_{slug}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "---\n"
        f'title: "STAMP — {go}"\n'
        "tags: [orbitty, stamp]\n"
        "status: stamped\n"
        f"go: {go}\n"
        "clinical_claim: false\n"
        "owner: pixel-artist\n"
        "---\n\n"
        f"# STAMP — {go}\n\n"
        f"Matt Dogfood `{cid}`: **green**. Dispatch fast-path (no nest clerk).\n"
    )
    return path


def complete_go_todos_on_green(go: str) -> list[str]:
    """Eyes-on green is the done signal — not the writer exit.

    Move exact-title `GO-…` todos that are still `doing` to `done`
    through `kanban move` (the one save door). Leftover bounce must
    not call this. Best-effort: a dead sock never un-stamps.
    """
    if not go:
        return []
    moved: list[str] = []
    try:
        st = ctl("state", "get")
    except SystemExit as e:
        with DISPATCH_LOG.open("a") as log:
            log.write(f"dogfood-green {go}: state get failed: {e}\n")
        return []
    if not isinstance(st, dict):
        return []
    for c in cards_from_state(st):
        if (c.get("kind") or "") != "todo":
            continue
        if (c.get("title") or "").strip() != go:
            continue
        if (c.get("status") or "") != "doing":
            continue
        cid = c.get("id") or ""
        if not cid:
            continue
        try:
            ctl("kanban", "move", "--id", cid, "--status", "done")
            moved.append(cid)
        except SystemExit as e:
            with DISPATCH_LOG.open("a") as log:
                log.write(f"dogfood-green {go}: move {cid} done failed: {e}\n")
    return moved


def dispatch_dogfood_leftover(rec: dict, raw_answer: str) -> bool:
    """GO-ORBITTY-LEFTOVER-CLERK: leftover bounce = papers file only.
    No Writer card, no cursor-go. True = handled; False = cannot fill →
    clerk ping (no invented scope). Never stamps, never moves the todo."""
    cid = rec.get("id") or ""
    # The papers go to plansDir; nothing is written under ~/.buzz. An older
    # clerk (no plans_dir support) would write into ~/.buzz/PLANS, so it is
    # never called: the clerk ping handles the bounce instead.
    if not getattr(leftover_clerk, "PLANS_DIR_AWARE", False):
        with DISPATCH_LOG.open("a") as log:
            log.write(f"leftover-clerk {cid}: helper has no plans_dir support — clerk ping\n")
        return False
    go_hint = extract_go(rec.get("title") or "") or ""
    info = go_status(go=go_hint) if go_hint else None
    res = leftover_clerk.handle(
        rec,
        script_path=str(SCRIPT),
        plans_dir=str(plans_dir()),
        first_prompt=(info or {}).get("file") or None,
        workspace=(info or {}).get("workspace") or None,
    )
    if not res.get("ok"):
        with DISPATCH_LOG.open("a") as log:
            log.write(
                f"leftover-clerk cannot-fill {cid}: {res.get('reason')} — clerk ping\n"
            )
        return False
    record_doing_fire_rule(cid, raw_answer)
    go = res.get("go") or "?"
    papers = Path(res.get("prompt") or "").name
    with DISPATCH_LOG.open("a") as log:
        log.write(f"leftover-clerk papers {go} {cid} {papers}\n")
    note = (
        f"Leftover for {go} parked in papers ({papers}). "
        "One launch per GO — not starting a second writer."
    )
    try:
        ctl("companion", "note", "--mode", "spark", "--", note)
    except SystemExit:
        pass
    return True


def dispatch_dogfood(rec: dict, raw_answer: str = "") -> bool:
    """True = handled (no nest clerk): green stamps, leftover bounce is a
    template fill. False = wait / cannot-fill → clerk."""
    answer = (rec.get("neededAnswer") or "").strip()
    if not DOGFOOD_GREEN_RE.match(answer):
        if not answer or DOGFOOD_WAIT_RE.match(answer):
            return False
        return dispatch_dogfood_leftover(rec, raw_answer)
    go = extract_go(rec.get("title") or "") or ""
    cid = rec.get("id") or ""
    path = stamp_dogfood_green(go, cid)
    moved = complete_go_todos_on_green(go)
    with DISPATCH_LOG.open("a") as log:
        log.write(
            f"dogfood-green {go or '?'} {cid} {path.name}"
            + (f" done={','.join(moved)}" if moved else "")
            + "\n"
        )
    if moved:
        note = f"{go or 'GO'} stamped; todo moved to done."
    else:
        note = f"{go or 'GO'} stamped."
    try:
        ctl("companion", "note", "--mode", "spark", "--", note)
    except SystemExit:
        pass
    return True


def dispatch_writer_or_nest(rec: dict) -> bool:
    """True if we handled it (no grok nest). Sign-off packet before any new session."""
    # RULE: lines are teaching, not a seat/green answer — strip before parsing.
    rec = dict(rec)
    raw_answer = rec.get("neededAnswer") or ""
    rec["neededAnswer"] = rules_mod.strip_rule_lines(raw_answer)
    title = rec.get("title") or ""
    answer = rec.get("neededAnswer") or ""
    # Dogfood GO-…? is eyes-on, not a writer launch. Green stamps here
    # (lock table). Leftover bounce is the template clerk (writes the
    # leftover papers in seconds — no Writer card, no nest).
    if title.startswith("Dogfood "):
        return dispatch_dogfood(rec, raw_answer)
    # GO-ORBITTY-DOING-FIRE: this fact title is planet-agent routing,
    # never a Writer seat — bare 'cursor' does not mean Ultra here.
    if title.strip() == DOING_FIRE_TITLE:
        return dispatch_doing_fire(rec, raw_answer)
    if title.startswith("Writer for ") and title.endswith("?"):
        go = extract_go(title)
        seat = seat_from_answer(answer)
        if not go or seat is None:
            return False
        leftover_title = " leftover" in title.lower()
        record_doing_fire_rule(rec.get("id") or "", raw_answer)
        if leftover_title:
            line = (
                f"Leftover for {go} is papers only. "
                "One launch per GO. Not launching."
            )
        else:
            line = (
                f"Writer for {go} parked."
                if seat == "wait"
                else launch_writer(seat, go)
            )
        already = line.lower().startswith("already")
        with DISPATCH_LOG.open("a") as log:
            log.write(f"writer {go} seat={seat} {line}\n")
        try:
            if seat != "wait" and not leftover_title and not already:
                subprocess.Popen(
                    [CTL, "companion", "play", "--", "nod"],
                    stdout=DISPATCH_LOG.open("a"),
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
        except (OSError, subprocess.SubprocessError):
            pass
        return True
    go = extract_go(answer) or extract_go(title)
    if not go:
        return False
    if not go_prompt_path(go).is_file():
        return False
    open_writer_signoff(rec, go)
    with DISPATCH_LOG.open("a") as log:
        log.write(f"signoff minted for {go} from {rec.get('id')}\n")
    return True


def dispatch_nest(rec: dict) -> None:
    """GO answers mint a writer sign-off packet. Other facts still nest-Grok papers."""
    ensure_bus()
    if dispatch_writer_or_nest(rec):
        cid = rec.get("id")
        if cid:
            src = INBOX / f"{cid}.json"
            if src.is_file():
                (ACKED / f"{cid}.json").write_text(src.read_text())
                src.unlink(missing_ok=True)
        return
    cid = rec.get("id") or "unknown"
    packet = packet_for(rec, rec.get("eventType") or "needed-answer")
    prompt_path = BUS / f"dispatch-{cid}.md"
    prompt_path.write_text(
        "Needed packet (complete). Do not resume any chat.\n\n```json\n"
        + json.dumps(packet, indent=2)
        + "\n```\n"
    )
    sid = str(uuid.uuid4())
    NEST_SESSION.write_text(
        json.dumps({"lastId": sid, "cardId": cid, "at": int(time.time())}, indent=2)
        + "\n"
    )
    with DISPATCH_LOG.open("a") as log:
        log.write(f"\n--- dispatch {cid} fresh {sid} ---\n")
    # Watched clerk: cap death earns ONE continuation (same packet + finish
    # note) — the silence after a Needed answer was the 12-turn corpse.
    spawn_clerk("nest", prompt_path, cid, sid)


def retry_stale(dispatch: bool) -> None:
    """Inbox is durable. If a grok died, fire a new one (max 3).
    Never stack a second clerk while one is still alive for that card."""
    if not dispatch:
        return
    now = int(time.time())
    for p in sorted(INBOX.glob("n-*.json")):
        try:
            rec = json.loads(p.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        cid = rec.get("id") or p.stem
        if clerk_alive(cid):
            continue
        attempts = int(rec.get("dispatchAttempts") or 1)
        last = int(rec.get("lastDispatchAt") or rec.get("queuedAt") or 0)
        if attempts >= 3 or now - last < 90:
            continue
        rec["dispatchAttempts"] = attempts + 1
        rec["lastDispatchAt"] = now
        p.write_text(json.dumps(rec, indent=2) + "\n")
        with DISPATCH_LOG.open("a") as log:
            log.write(f"retry {cid} attempt {attempts + 1}\n")
        try:
            dispatch_nest(rec)
        except (OSError, subprocess.SubprocessError) as e:
            with DISPATCH_LOG.open("a") as log:
                log.write(f"retry failed {cid}: {e}\n")


def enqueue(rec: dict, etype: str, spark: bool, dispatch: bool) -> Path | None:
    cid = rec.get("id")
    if not cid:
        return None
    ensure_bus()
    dest = INBOX / f"{cid}.json"
    acked = ACKED / f"{cid}.json"
    if dest.is_file() or acked.is_file():
        return None
    payload = dict(rec)
    payload["eventType"] = etype
    payload["queuedAt"] = int(time.time())
    payload["lastDispatchAt"] = payload["queuedAt"]
    payload["dispatchAttempts"] = 1
    payload["packet"] = packet_for(payload, etype)
    body = json.dumps(payload, indent=2) + "\n"
    try:
        fd = os.open(dest, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    except FileExistsError:
        return None
    with os.fdopen(fd, "w") as f:
        f.write(body)
    if spark and should_instant_ack(payload):
        try:
            spark_ack(payload)
        except (OSError, subprocess.SubprocessError):
            pass
    if dispatch:
        try:
            dispatch_nest(rec)
        except (OSError, subprocess.SubprocessError) as e:
            with DISPATCH_LOG.open("a") as log:
                log.write(f"dispatch failed {rec.get('id')}: {e}\n")
    return dest


def drain_events(cur: dict, spark: bool, dispatch: bool) -> list[dict]:
    if not EVENTS.is_file():
        return []
    size = EVENTS.stat().st_size
    off = int(cur.get("offset") or 0)
    if size < off:
        off = 0
    seen = list(cur.get("seen") or [])
    seen_set = set(seen)
    out: list[dict] = []
    with EVENTS.open("r", encoding="utf-8") as f:
        f.seek(off)
        while True:
            line = f.readline()
            if not line:
                break
            if not line.endswith("\n"):
                break
            off = f.tell()
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            et = event_type(ev)
            if et not in ("needed-answer", "needed-skip"):
                continue
            cid = event_card_id(ev)
            if not cid or cid in seen_set:
                continue
            try:
                rec = card_rec(find_card(cid))
            except SystemExit:
                rec = {
                    "id": cid,
                    "title": None,
                    "neededState": "skipped" if et == "needed-skip" else "answered",
                    "neededAnswer": None,
                }
            path = enqueue(rec, et, spark, dispatch)
            seen_set.add(cid)
            seen.append(cid)
            if path is not None:
                rec["queued"] = str(path)
                out.append(rec)
    cur["offset"] = off
    cur["seen"] = seen[-400:]
    save_cursor(cur)
    return out


