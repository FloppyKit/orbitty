def cmd_issued(args: argparse.Namespace) -> None:
    action = args.action
    if action == "show":
        d = load_issued()
        if args.go:
            d = {args.go.upper(): d.get(args.go.upper())} if d.get(args.go.upper()) else {}
        json.dump(d, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return
    go = (args.go or "").upper()
    if not go:
        raise SystemExit("issued check|mark|shipped needs GO")
    if action == "check":
        st = issued_status(go, args.prompt)
        if args.json:
            json.dump(st, sys.stdout, indent=2)
            sys.stdout.write("\n")
        else:
            print(st.get("message") or st.get("status"))
        if st.get("status") == "running":
            raise SystemExit(5)
        if st.get("status") == "shipped":
            raise SystemExit(6)
        return
    if action == "mark":
        if not args.pid:
            raise SystemExit("issued mark needs --pid")
        rec = issued_mark(
            go, pid=args.pid, seat=args.seat, prompt=args.prompt
        )
        json.dump(rec, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return
    if action == "shipped":
        rec = issued_shipped(go, commit=args.commit, prompt=args.prompt)
        json.dump(rec, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return
    raise SystemExit(f"unknown issued action {action}")


