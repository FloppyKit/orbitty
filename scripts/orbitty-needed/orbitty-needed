#!/usr/bin/env python3
"""orbitty-needed — agent bus for Launchpad Needed cards.

Mint a question, list open ones, wait, and watch answers so a nest
Grok session can act without hunting a TTY.

  orbitty-needed open --title "…" [--why "…"] [--project P]
  orbitty-needed list [--all]
  orbitty-needed get ID
  orbitty-needed wait ID [--timeout 3600] [--poll 2]
  orbitty-needed pending
  orbitty-needed ack ID
  orbitty-needed watch [--poll 2] [--no-ack-spark]
  orbitty-needed issued check|mark|shipped|show GO
  orbitty-needed rule list
  orbitty-needed rule add --param k=v ... --answer "…" [--from-needed n-…] [--note "…"]
  orbitty-needed rule from-answer ID
  orbitty-needed rule rm ID
"""
