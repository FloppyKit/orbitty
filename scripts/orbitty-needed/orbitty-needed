QUERY_CAP = 64000


PACKETS = BUS / "go-packets"


class Sealed(NamedTuple):
    """packet = the file a route hands the agent; None = don't launch.
    checked = False when the seal check itself was unavailable."""
    packet: Path | None
    note: str
    source: Path | None
    checked: bool


def write_go_packet(go: str, workspace: str, query: str) -> Path:
    """The launch text as a file. The leading `Workspace:` line is what
    clerk_argv / issued_* / cursor-go read for the working directory."""
    PACKETS.mkdir(parents=True, exist_ok=True)
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", go) or "GO"
    path = PACKETS / f"{safe}.md"
    tmp = path.with_suffix(".md.tmp")
    tmp.write_text(f"Workspace: {workspace}\n\n{query.rstrip()}\n")
    tmp.replace(path)
    return path


def sealed_prompt(go: str, card: str = "", prompt: str | None = None) -> Sealed:
    """The seal gate through orbittyctl. The app builds the launch text
    (`query`: the GO with {REPO_ROOT}/{PLANS_DIR} expanded, the lock
    appended, and the push rule), so the clerk and cursor-go routes get
    exactly what the Rust routes get."""
    info = go_status(file=prompt or "", go=go, card=card)
    if not info:
        return Sealed(None, f"{go} seal check unavailable; not launching.", None, False)
    if not info.get("sealed"):
        note = (info.get("note") or "").strip() or f"{go} is not sealed; not launching."
        return Sealed(None, note, None, True)
    launch_note = (info.get("launchNote") or "").strip()
    if launch_note:
        return Sealed(None, launch_note, None, True)
    source = Path(info.get("file") or (prompt or ""))
    query = info.get("query")
    if not isinstance(query, str) or not query.strip():
        return Sealed(None, f"{go} seal check returned no GO text; not launching.", None, True)
    workspace = (info.get("workspace") or "").strip() or str(WS_DEFAULT)
    packet_text = f"Workspace: {workspace}\n\n{query}"
    if len(packet_text) > QUERY_CAP:
        return Sealed(
            None,
            f"{go} is {len(packet_text)} chars; cap is {QUERY_CAP}. Not launching.",
            None,
            True,
        )
    return Sealed(write_go_packet(go, workspace, query), "", source, True)


def append_card_note(card_id: str, note: str, log) -> bool:
    """Add one line to the card's notes. Never replaces them: the append
    verb only (an older app answers unknown tool, which is logged)."""
    if not card_id or not note.strip():
        return False
    try:
        ctl("kanban", "notes", "--id", card_id, "--append", "--", note)
        return True
    except SystemExit as e:
        log(f"note append failed for {card_id}: {e}")
        return False


def go_prompt_path(go: str) -> Path:
    slug = f"_{go.replace('-', '_')}_PROMPT.md"
    primary = plans_dir() / slug
    if primary.is_file():
        return primary
    legacy = PLANS / slug
    if legacy.is_file():
        return legacy
    return primary


def launch_packet(rec: dict, go: str) -> dict:
    prompt = go_prompt_path(go)
    ws = ""
    if prompt.is_file():
        for line in prompt.read_text().splitlines():
            if line.startswith("Workspace:"):
                ws = line.split(":", 1)[1].strip()
                break
    return {
        "go": go,
        "neededId": rec.get("id"),
        "title": rec.get("title"),
        "answer": rec.get("neededAnswer"),
        "why": rec.get("neededWhy"),
        "projectId": rec.get("projectId") or "",
        "workspace": ws or str(HOME / "orbitty"),
        "prompt": str(prompt) if prompt.is_file() else None,
        "seats": ["cursor", "grok"],
        "suggested": "cursor",
        "note": "Sign off the writer for this GO. Answer cursor / grok / wait. Nest will not code.",
    }


