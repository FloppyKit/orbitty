{
  "manifest_version": 3,
  "name": "Tabbity",
  "version": "0.1.0",
  "description": "Claim browser tabs onto Orbitty planets.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabbity"
  }
}
